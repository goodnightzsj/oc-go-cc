/testdata/

# Runtime databases hold real usage records and must never be committed.
# The deployed DB lives in ~/.local/share/routatic-proxy/, so these only
# catch a local run pointed at a relative path.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
