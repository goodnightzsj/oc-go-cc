[
 {
  "_comment": "OpenRouter pricing (USD per 1M tokens), transcribed from https://openrouter.ai/api/v1/models. Regenerated 2026-10-23. A runtime refresher rewrites this hourly; this baseline is what a failed refresh falls back to."
 },
 {
  "_comment": "OpenRouter is a router, not a vendor: it resells other providers' models and passes their prices through without markup. The listing is the only machine-readable statement of those prices, which is why this table is a snapshot rather than something maintained by hand - it changes whenever an upstream does."
 },
 {
  "_comment": "The endpoint states the cost of a single token as a string; these entries are already scaled to per-million. Models whose listing carried no usable rate are omitted rather than recorded as zero: zero is a real price here (free models), and conflating the two would make an unpriced model look free."
 },
