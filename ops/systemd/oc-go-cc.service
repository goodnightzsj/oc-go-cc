[Unit]
Description=routatic-proxy — OpenCode Go proxy for Claude Code
After=network-online.target
Wants=network-online.target
# A crash loop that never backs off is invisible: the only symptom is a journal
# full of the same line. Bound it so the unit lands in failed state instead.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/root/oc-go-cc
ExecStart=/root/oc-go-cc/.tmp/prod/current/routatic-proxy start
Restart=always
RestartSec=5
TimeoutStopSec=630
Environment=HOME=/root
# The dashboard answers only to loopback names unless the public name is
# declared here (or in the EnvironmentFile). A panel behind nginx needs it:
# nginx forwards the original Host, so every page is refused otherwise.
# Environment=ROUTATIC_PROXY_GUI_ALLOWED_HOSTS=dashboard.example.com
EnvironmentFile=-/root/oc-go-cc/.env
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
