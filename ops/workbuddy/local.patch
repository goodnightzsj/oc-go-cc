+				out, requested, effective := c.prepareBody(in, tc.realm, "", "")
+				var body map[string]any
+				if err := json.Unmarshal(out, &body); err != nil {
+					t.Fatal(err)
+				}
+				if body[field] != tc.want || requested != "max" || effective != tc.want || body["model"] != tc.model {
+					t.Fatalf("body=%s requested=%q effective=%q want=%q", out, requested, effective, tc.want)
+				}
+			})
+		}
+	}
+	levels, _ := EffortListing("global", "deepseek-v4.1-flash", nil, "")
+	if !reflect.DeepEqual(levels, []string{"low", "high", "max"}) {
+		t.Fatalf("fallback listing=%v", levels)
+	}
+	levels, _ = EffortListing("global", "deepseek-v4.1-flash", []string{"high"}, "")
