new file mode 100644
index 0000000..e1c65cc
--- /dev/null
+++ b/cmd/server/resin.go
@@ -0,0 +1,9 @@
+package main
+
+import "github.com/misakano7545/workbuddy2api-panel/internal/upstream"
+
+func applyResinProxy(up *upstream.Client, cfg *Config) error {
+	return up.SetResinProxy(upstream.ResinProxy{
+		URL: cfg.Resin.URL, Token: cfg.Resin.Token, Platform: cfg.Resin.Platform,
+	})
+}
diff --git a/cmd/server/resin_test.go b/cmd/server/resin_test.go
new file mode 100644
index 0000000..792ead0
--- /dev/null
+++ b/cmd/server/resin_test.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"net/http"
+	"slices"
+	"testing"
+
+	"github.com/misakano7545/workbuddy2api-panel/internal/upstream"
+)
+
+func TestLocalResinConfiguration(t *testing.T) {
+	cfg, err := ParseConfig([]byte(`{"resin":{"url":"http://127.0.0.1:12260","token":"synthetic","platform":"pool"}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	u := upstream.New()
+	if err := applyResinProxy(u, cfg); err != nil {
+		t.Fatal(err)
+	}
+	r, _ := http.NewRequest("GET", "https://example.invalid/", nil)
+	r.Header.Set("X-User-Id", "a")
+	p, err := u.HTTP.Transport.(*http.Transport).Proxy(r)
+	if err != nil || p.User.Username() != "pool.a" {
+		t.Fatal("config not applied")
+	}
+	previous := *cfg
+	previous.Resin.URL, previous.Resin.Token, previous.Resin.Platform = "", "", ""
+	for _, name := range []string{"resin.url", "resin.token", "resin.platform"} {
+		if !slices.Contains(restartRequiredFields(&previous, cfg), name) {
+			t.Fatalf("missing restart marker %s", name)
+		}
+	}
+	cfg.Resin.URL = "relative"
+	if err := applyResinProxy(upstream.New(), cfg); err == nil {
+		t.Fatal("invalid proxy silently bypassed")
+	}
+}
