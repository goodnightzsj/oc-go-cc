+
+	"github.com/misakano7545/workbuddy2api-panel/internal/auth"
+	"github.com/misakano7545/workbuddy2api-panel/internal/reqlog"
+	"github.com/misakano7545/workbuddy2api-panel/internal/usage"
+)
+
+const localErrorSSE = `data: {"choices":[{"delta":{"content":"partial"}}],"usage":{"prompt_tokens":7,"completion_tokens":3,"total_tokens":10,"credit":0.25}}` + "\n\n" +
+	`data: {"code":11140,"msg":"synthetic failure","requestId":"test-request"}` + "\n\ndata: [DONE]\n\n"
+
+func TestLocalAggregateFailureReachesHTTPAndHistory(t *testing.T) {
+	for _, rescue := range []bool{false, true} {
+		t.Run(map[bool]string{false: "direct", true: "starved-rescue"}[rescue], func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				calls := 0
+				up := newFakeUpstream(t, func(string) (int, string, bool) {
+					calls++
+					time.Sleep(time.Duration(calls) * time.Second)
+					if rescue && calls == 1 {
+						return 200, testSeg1Starved, true
+					}
+					return 200, localErrorSSE, true
+				})
+				p := testPoolWith(&auth.Auth{UID: "test-one", AccessToken: "test-only", ExpiresAt: 9999999999})
+				log := reqlog.New(reqlog.Config{})
+				recorded := usage.New("")
+				h := NewHandler(Config{Pool: p, Upstream: up, RequestLog: log, Usage: recorded})
+				rec := httptest.NewRecorder()
+				h.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"deepseek-v4.1-flash","max_tokens":200,"messages":[{"role":"user","content":"synthetic"}]}`)))
+				if rec.Code != 502 {
+					t.Fatalf("status=%d body=%s", rec.Code, rec.Body)
+				}
+				var body map[string]any
+				if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+					t.Fatal(err)
+				}
+				if body["error"] == nil || body["choices"] != nil || !strings.Contains(rec.Body.String(), "test-request") {
+					t.Fatalf("lost source error: %s", rec.Body)
+				}
+				u, _ := body["usage"].(map[string]any)
+				if u["completion_tokens"] != float64(3) {
+					t.Fatalf("lost partial usage: %#v", body)
+				}
+				want := 1
+				if rescue {
+					want = 2
+				}
+				if calls != want {
+					t.Fatalf("calls=%d want=%d", calls, want)
+				}
+				snap := log.Snapshot()
+				if len(snap.Recent) != 1 {
+					t.Fatalf("history rows=%d", len(snap.Recent))
+				}
+				e := snap.Recent[0]
+				if e.OK || e.Outcome == reqlog.OutcomeSuccess || e.Status != 502 || e.CompletionTokens != 3 || e.Attempts != want || !e.HasCredit || e.Credit != 0.25 {
+					t.Fatalf("bad failure history: %#v", e)
+				}
+				totals := recorded.Snapshot(24, nil).Totals
+				wantTokens, wantLatency := int64(3), float64(1000)
+				if rescue {
+					wantTokens, wantLatency = 203, 1500
+				}
+				if totals.Requests != int64(want) || totals.Errors != 1 || totals.CompletionTok != wantTokens || totals.Credits != 0.25 {
+					t.Errorf("partial failure accounting: %#v", totals)
+				}
+				if totals.AvgLatencyMs != wantLatency {
+					t.Errorf("attempt latency=%v want=%v", totals.AvgLatencyMs, wantLatency)
+				}
+			})
+		})
+	}
+}
+
+func TestLocalSearchProbeReturnsExplicitFailureWithoutRetry(t *testing.T) {
+	calls := 0
+	up := newFakeUpstream(t, func(string) (int, string, bool) { calls++; return 200, localErrorSSE, true })
+	p := testPoolWith(&auth.Auth{UID: "test-one", AccessToken: "test-only", ExpiresAt: 9999999999}, &auth.Auth{UID: "test-two", AccessToken: "test-only-two", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: up})
+	obj, err := h.probeOnce(context.Background(), "cn", "deepseek-v4.1-flash", []byte(`{"model":"deepseek-v4.1-flash","messages":[]}`))
+	if err == nil || calls != 1 || obj["error"] == nil {
+		t.Fatalf("probe hid or retried explicit failure: calls=%d obj=%#v err=%v", calls, obj, err)
+	}
+}
