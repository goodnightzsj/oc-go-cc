+package upstream
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestLocalAggregateExplicitError(t *testing.T) {
+	for _, failure := range []string{
+		`{"error":{"code":6004,"message":"synthetic failure","requestId":"test-request"}}`,
+		`{"code":11140,"msg":"synthetic failure","requestId":"test-request"}`,
+	} {
+		for _, partial := range []bool{false, true} {
+			for _, done := range []bool{false, true} {
+				for _, separator := range []string{"data: ", "data:"} {
+					t.Run(fmt.Sprintf("%s/partial=%t/done=%t/space=%t", failure, partial, done, separator == "data: "), func(t *testing.T) {
+						prefix, suffix := "", ""
+						if partial {
+							prefix = `data: {"choices":[{"delta":{"content":"partial"}}],"usage":{"prompt_tokens":7,"completion_tokens":3,"completion_tokens_details":{"reasoning_tokens":2}}}` + "\n\n"
+						}
+						if done {
+							suffix = "data: [DONE]\n\n"
+						}
+						resp, err := Aggregate(strings.NewReader(prefix + separator + failure + "\r\n\r\n" + suffix))
+						if err == nil {
+							t.Fatalf("explicit error became success: %#v", resp)
+						}
+						if resp["error"] == nil || resp["choices"] != nil {
+							t.Fatalf("not an error response: %#v", resp)
+						}
+						raw, _ := json.Marshal(resp["error"])
+						if !strings.Contains(string(raw), "synthetic failure") || !strings.Contains(string(raw), "test-request") {
+							t.Fatalf("lost error details: %s", raw)
+						}
+						if partial {
+							u, _ := resp["usage"].(map[string]any)
+							if u["completion_tokens"] != float64(3) || u["total_tokens"] != float64(10) {
+								t.Fatalf("lost partial usage: %#v", u)
+							}
+							if d, _ := u["completion_tokens_details"].(map[string]any); d["reasoning_tokens"] != float64(2) {
+								t.Fatalf("lost reasoning usage: %#v", u)
+							}
+						} else if resp["usage"] != nil {
+							t.Fatalf("invented usage: %#v", resp)
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestLocalAggregateErrorShapedContentIsNotFailure(t *testing.T) {
+	raw := `data: {"code":11140,"error":null,"choices":[{"delta":{"content":"request illegal 11140"},"finish_reason":"stop"}],"usage":{"prompt_tokens":0,"completion_tokens":0}}` + "\n\ndata: [DONE]\n\n"
+	resp, err := Aggregate(strings.NewReader(raw))
+	if err != nil || resp["error"] != nil {
+		t.Fatalf("ordinary content rejected: %#v %v", resp, err)
+	}
+	u := resp["usage"].(map[string]any)
+	if u["completion_tokens"] != float64(0) {
+		t.Fatal("explicit zero usage lost")
+	}
+}
+
+func TestLocalAggregatePartialErrorUsage(t *testing.T) {
+	for _, tokens := range []string{"", `,"completion_tokens":0`} {
+		raw := `data: {"choices":[{"delta":{"content":"partial"}}],"usage":{"prompt_tokens":7,"completion_tokens":3,"total_tokens":10,"completion_tokens_details":{"reasoning_tokens":2}}}` + "\n\n" +
+			`data: {"error":{"message":"failed"},"usage":{"credit":0.25,"completion_tokens_details":{"accepted_prediction_tokens":1}` + tokens + `}}` + "\n\n"
+		resp, err := Aggregate(strings.NewReader(raw))
+		if err == nil {
+			t.Fatal("explicit failure became success")
+		}
+		u, _ := resp["usage"].(map[string]any)
+		want := float64(3)
+		if tokens != "" {
+			want = 0
+		}
+		if u["prompt_tokens"] != float64(7) || u["completion_tokens"] != want || u["total_tokens"] != 7+want || u["credit"] != 0.25 {
+			t.Errorf("partial error usage lost: %#v", u)
+		}
+		d, _ := u["completion_tokens_details"].(map[string]any)
+		if d["reasoning_tokens"] != float64(2) || d["accepted_prediction_tokens"] != float64(1) {
+			t.Errorf("partial details lost: %#v", d)
+		}
+	}
+}
+
+func TestLocalAggregateLatestCacheObservation(t *testing.T) {
+	for _, cached := range []float64{0, 5} {
+		raw := `data: {"choices":[],"usage":{"prompt_tokens":7,"completion_tokens":3,"prompt_tokens_details":{"cached_tokens":2,"audio_tokens":1}}}` + "\n\n" +
+			fmt.Sprintf(`data: {"error":{"message":"failed"},"usage":{"prompt_cache_hit_tokens":%v}}`, cached) + "\n\n"
+		resp, err := Aggregate(strings.NewReader(raw))
+		if err == nil {
+			t.Fatal("expected failure")
+		}
+		u := resp["usage"].(map[string]any)
+		if u["prompt_cache_hit_tokens"] != cached {
+			t.Errorf("latest cache lost: %#v", u)
+		}
+		d := u["prompt_tokens_details"].(map[string]any)
+		if d["audio_tokens"] != float64(1) {
+			t.Errorf("unrelated details lost: %#v", d)
+		}
+		if v, ok := d["cached_tokens"]; ok && v != cached {
+			t.Errorf("stale cache details: %#v", d)
+		}
+	}
+}
