@@ -0,0 +1,81 @@
+package upstream
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// Release a final buffered event on Close so returning before the reader joins
+// deterministically loses the counters, even without the race detector.
+type localWebTurnBody struct {
+	closed chan struct{}
+	once   sync.Once
+	reader *strings.Reader
+}
+
+func (b *localWebTurnBody) Read(p []byte) (int, error) {
+	<-b.closed
+	return b.reader.Read(p)
+}
+
+func (b *localWebTurnBody) Close() error {
+	b.once.Do(func() { close(b.closed) })
+	return nil
+}
+
+func TestLocalWebAgentTurnJoinsReader(t *testing.T) {
+	for _, tc := range []struct {
+		name, status, failMethod, wantError string
+		cancel                              bool
+	}{
+		{name: "completed", status: "completed"},
+		{name: "failed", status: "failed", wantError: "status=failed"},
+		{name: "initialize", failMethod: "initialize", wantError: "acp initialize"},
+		{name: "load", failMethod: "session/load", wantError: "acp session/load"},
+		{name: "prompt", failMethod: "session/prompt", wantError: "acp session/prompt"},
+		{name: "set-model nonfatal", status: "completed", failMethod: "session/set_model"},
+		{name: "canceled", status: "working", cancel: true, wantError: "context canceled"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			body := &localWebTurnBody{closed: make(chan struct{}), reader: strings.NewReader(
+				"data: {\"method\":\"session/update\",\"params\":{\"update\":{\"sessionUpdate\":\"agent_message_chunk\"}}}\n\n" +
+					"data: {\"method\":\"session/endTurn\"}\n\n")}
+			c := &Client{ChatBaseCN: "https://web.test"}
+			c.HTTP = &http.Client{Transport: rtFunc(func(r *http.Request) (*http.Response, error) {
+				if r.URL.Path == "/acp" && r.Method == http.MethodGet {
+					return &http.Response{StatusCode: 200, Header: http.Header{"Acp-Connection-Id": {"test"}}, Body: body}, nil
+				}
+				status, reply := 200, `{"data":{"status":"`+tc.status+`"}}`
+				if r.Method == http.MethodPost {
+					payload, err := io.ReadAll(r.Body)
+					if err != nil {
+						return nil, err
+					}
+					if tc.failMethod != "" && strings.Contains(string(payload), `"method":"`+tc.failMethod+`"`) {
+						status = 500
+					}
+				} else if tc.cancel {
+					cancel()
+				}
+				return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(reply))}, nil
+			})}
+			res, err := c.RunWebAgentTurn(ctx, webTestAuth(), "c1", WebSession{Link: "https://web.test/acp", Token: "test"}, "", "")
+			if (err != nil) != (tc.wantError != "") || (err != nil && !strings.Contains(err.Error(), tc.wantError)) {
+				t.Fatalf("err=%v, want %q", err, tc.wantError)
+			}
+			if tc.cancel && !errors.Is(err, context.Canceled) {
+				t.Fatalf("lost cancellation: %v", err)
+			}
+			if res.Events != 2 || res.Chunks != 1 || res.Conversation != "c1" || res.SetModelFailed != (tc.failMethod == "session/set_model") {
+				t.Fatalf("unstable or incomplete result after stream close: %+v", res)
+			}
+		})
+	}
+}
