+package upstream
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestLocalDeepSeekMaxFallback(t *testing.T) {
+	for _, tc := range []struct {
+		name, realm, model string
+		remote             []string
+		want               string
+	}{
+		{"global fallback", "global", "deepseek-v4.1-flash", nil, "max"},
+		{"global remote max", "global", "deepseek-v4.1-flash", []string{"low", "high", "max"}, "max"},
+		{"remote high remains authoritative", "global", "deepseek-v4.1-flash", []string{"high"}, "high"},
+		{"CN remote max", "cn", "deepseek-v4.1-flash", []string{"low", "high", "max"}, "max"},
+		{"SG remote max", "global", "deepseek-v4.1-flash-sg", []string{"low", "high", "max"}, "max"},
+		{"GLM ladder unchanged", "global", "glm-5.2", nil, "xhigh"},
+		{"Kimi ladder unchanged", "global", "kimi-k3", nil, "medium"},
+	} {
+		for _, field := range []string{"reasoning_effort", "reasoningEffort"} {
+			t.Run(tc.name+"/"+field, func(t *testing.T) {
+				c := &Client{}
+				if tc.remote != nil {
+					c.storeEfforts(tc.realm, map[string][]string{tc.model: tc.remote}, nil)
+				}
+				in, err := json.Marshal(map[string]any{"model": tc.realm + ":" + tc.model, field: "max", "messages": []any{}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				out, requested, effective := c.prepareBody(in, tc.realm, "", "")
+				var body map[string]any
+				if err := json.Unmarshal(out, &body); err != nil {
+					t.Fatal(err)
+				}
+				if body[field] != tc.want || requested != "max" || effective != tc.want || body["model"] != tc.model {
+					t.Fatalf("body=%s requested=%q effective=%q want=%q", out, requested, effective, tc.want)
+				}
+			})
+		}
+	}
+	levels, _ := EffortListing("global", "deepseek-v4.1-flash", nil, "")
+	if !reflect.DeepEqual(levels, []string{"low", "high", "max"}) {
+		t.Fatalf("fallback listing=%v", levels)
+	}
+	levels, _ = EffortListing("global", "deepseek-v4.1-flash", []string{"high"}, "")
+	if !reflect.DeepEqual(levels, []string{"high"}) {
+		t.Fatalf("remote listing overridden: %v", levels)
+	}
+	for _, tc := range []struct{ input, want string }{
+		{`{"model":"global:deepseek-v4.1-flash"}`, "high"},
+		{`{"model":"global:deepseek-v4.1-flash","reasoning_effort":"low"}`, "low"},
+		{`{"model":"global:deepseek-v4.1-flash","reasoning_effort":"medium"}`, "high"},
+		{`{"model":"global:deepseek-v4.1-flash","reasoning_effort":"off"}`, ""},
+	} {
+		_, _, effective := (&Client{}).prepareBody([]byte(tc.input), "global", "", "")
+		if effective != tc.want {
+			t.Errorf("input=%s effective=%q want=%q", tc.input, effective, tc.want)
+		}
+	}
+}
diff --git a/internal/upstream/resin_proxy.go b/internal/upstream/resin_proxy.go
new file mode 100644
index 0000000..1ec7650
--- /dev/null
+++ b/internal/upstream/resin_proxy.go
@@ -0,0 +1,58 @@
+package upstream
+
+import (
+	"errors"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+type ResinProxy struct {
+	URL, Token, Platform string
+}
+
+// Configure transports before serving; invalid configuration must not bypass Resin.
+func (c *Client) SetResinProxy(p ResinProxy) error {
+	fn, err := p.proxyFunc()
+	if err != nil || fn == nil {
+		return err
+	}
+	for _, cl := range []*http.Client{c.HTTP, c.ChatHTTP} {
+		if cl != nil {
+			if _, ok := cl.Transport.(*http.Transport); !ok {
+				return errors.New("resin requires an HTTP transport")
+			}
+		}
+	}
+	for _, cl := range []*http.Client{c.HTTP, c.ChatHTTP} {
+		if cl != nil {
+			cl.Transport.(*http.Transport).Proxy = fn
+		}
+	}
+	return nil
+}
+
+func (r ResinProxy) proxyFunc() (func(*http.Request) (*url.URL, error), error) {
+	if r.URL == "" {
+		return nil, nil
+	}
+	base, err := url.Parse(r.URL)
+	if err != nil || base.Hostname() == "" || (base.Scheme != "http" && base.Scheme != "https") {
+		return nil, errors.New("resin.url must be an absolute HTTP(S) URL")
+	}
+	platform := r.Platform
+	if platform == "" {
+		platform = "Default"
+	}
+	return func(req *http.Request) (*url.URL, error) {
+		u := *base
+		// UID survives access-token refresh and keeps each account on its own exit.
+		account := strings.TrimSpace(req.Header.Get("X-User-Id"))
+		if account != "" {
+			u.User = url.UserPassword(platform+"."+account, r.Token)
+		} else if r.Token != "" {
+			u.User = url.UserPassword(platform, r.Token)
+		}
+		return &u, nil
+	}, nil
+}
