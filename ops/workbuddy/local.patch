@@ -0,0 +1,58 @@
+package upstream
+
+import (
+	"errors"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+type ResinProxy struct {
+	URL, Token, Platform string
+}
+
+// Configure transports before serving; invalid configuration must not bypass Resin.
+func (c *Client) SetResinProxy(p ResinProxy) error {
+	fn, err := p.proxyFunc()
+	if err != nil || fn == nil {
+		return err
+	}
+	for _, cl := range []*http.Client{c.HTTP, c.ChatHTTP} {
+		if cl != nil {
+			if _, ok := cl.Transport.(*http.Transport); !ok {
+				return errors.New("resin requires an HTTP transport")
+			}
+		}
+	}
+	for _, cl := range []*http.Client{c.HTTP, c.ChatHTTP} {
+		if cl != nil {
+			cl.Transport.(*http.Transport).Proxy = fn
+		}
+	}
+	return nil
+}
+
+func (r ResinProxy) proxyFunc() (func(*http.Request) (*url.URL, error), error) {
+	if r.URL == "" {
+		return nil, nil
+	}
+	base, err := url.Parse(r.URL)
+	if err != nil || base.Hostname() == "" || (base.Scheme != "http" && base.Scheme != "https") {
+		return nil, errors.New("resin.url must be an absolute HTTP(S) URL")
+	}
+	platform := r.Platform
+	if platform == "" {
+		platform = "Default"
+	}
+	return func(req *http.Request) (*url.URL, error) {
+		u := *base
+		// UID survives access-token refresh and keeps each account on its own exit.
+		account := strings.TrimSpace(req.Header.Get("X-User-Id"))
+		if account != "" {
+			u.User = url.UserPassword(platform+"."+account, r.Token)
+		} else if r.Token != "" {
+			u.User = url.UserPassword(platform, r.Token)
+		}
+		return &u, nil
+	}, nil
+}
