+package upstream
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestResinProxy(t *testing.T) {
+	c := New()
+	if err := c.SetResinProxy(ResinProxy{URL: "http://127.0.0.1:12260", Token: "synthetic", Platform: "pool"}); err != nil {
+		t.Fatal(err)
+	}
+	for _, cl := range []*http.Client{c.HTTP, c.ChatHTTP} {
+		for _, tc := range []struct{ uid, token, want string }{
+			{"a", "old", "pool.a"}, {"a", "refreshed", "pool.a"}, {"b", "other", "pool.b"}, {"", "", "pool"},
+		} {
+			r, _ := http.NewRequest("GET", "https://example.invalid/models", nil)
+			r.Header.Set("X-User-Id", tc.uid)
+			r.Header.Set("Authorization", tc.token)
+			u, err := cl.Transport.(*http.Transport).Proxy(r)
+			if err != nil {
+				t.Fatal(err)
+			}
+			pw, _ := u.User.Password()
+			if u.User.Username() != tc.want || pw != "synthetic" || u.Host != "127.0.0.1:12260" || r.URL.Host != "example.invalid" {
+				t.Fatal("proxy identity or destination changed")
+			}
+		}
+	}
+	for _, bad := range []string{"%", "relative", "file:///tmp/proxy"} {
+		if err := c.SetResinProxy(ResinProxy{URL: bad}); err == nil {
+			t.Fatalf("accepted %q", bad)
+		}
+	}
+	plain := New()
+	if err := plain.SetResinProxy(ResinProxy{}); err != nil {
+		t.Fatal(err)
+	}
+	if plain.HTTP.Transport.(*http.Transport).Proxy != nil {
+		t.Fatal("empty config enabled proxy")
+	}
+}
