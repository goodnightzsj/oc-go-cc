 package upstream
 
+// Aggregate usage frames are cumulative observations, not additive deltas.
+func mergeAggregateUsage(previous, current map[string]any) map[string]any {
+	out := cloneUsageMap(previous)
+	if _, total := current["total_tokens"]; !total {
+		_, prompt := current["prompt_tokens"]
+		_, completion := current["completion_tokens"]
+		if prompt || completion {
+			delete(out, "total_tokens")
+		}
+	}
+	for _, path := range usageCachePaths {
+		fields := current
+		if path.section != "" {
+			fields, _ = current[path.section].(map[string]any)
+		}
+		if value, ok := fields[path.key].(float64); ok && value >= 0 {
+			// Alias priority applies within a frame, never over a newer observation.
+			for _, oldPath := range usageCachePaths {
+				if oldPath.section == "" {
+					delete(out, oldPath.key)
+				} else if _, exists := out[oldPath.section]; exists {
+					details := cloneUsageDetails(out, oldPath.section)
+					delete(details, oldPath.key)
+					out[oldPath.section] = details
+				}
+			}
+			break
+		}
+	}
+	for key, value := range current {
+		if details, ok := value.(map[string]any); ok {
+			merged := cloneUsageDetails(out, key)
+			for detailKey, detailValue := range details {
+				merged[detailKey] = detailValue
+			}
+			value = merged
+		}
+		out[key] = value
+	}
+	return out
+}
